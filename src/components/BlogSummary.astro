---
import { formatPostDate } from "../utils/date";

const { post } = Astro.props;
---

<li class="blog-summary" transition:animate="fade">
  <article>
    <div>
      <h3>
        <a
          class="blog-summary__link"
          href={post.data.link === "" || !post.data.link
            ? "/posts/" + post.id
            : post.data.link}
          target={post.data.link && "_blank"}
          >{post.data.title}
        </a>
      </h3>
      <span>{formatPostDate(post.data.pubDate).date}</span>
    </div>
  </article>
</li>

<style lang="scss">
  @use "../styles/mixins";
  .blog-summary {
    padding: 0 0 1.2em 0;
    margin: 0 0.2em;
    display: flex;
    flex-direction: column;

    &__link {
      color: var(--color);
      margin: 0 0 1em 0;
      text-decoration: none;
      @include mixins.underline-link;
      @include mixins.blog-title-link;
      font-size: 1.2em;
      &:hover,
      &:focus {
        transform: scale(2);
        transition: all 2ms;
      }
    }

    &__tags {
      display: flex;
      @include mixins.reset-list;
    }

    &:last-of-type {
      border-bottom: none;
    }
  }
</style>
