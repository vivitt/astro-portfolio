---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import viviana from "../images/about/viviana.png";
import tigre from "../images/about/tigre.gif";
import background from "../images/about/background.png";
const pageTitle = "About Me";
---

<Layout title={pageTitle}>
  <main class="about">
    <h1 class="visually-hidden">Vivi Yanez, about me</h1>
    <h2 aria-hidden="true">Hi, I'm Viviana.</h2>

    <div class="about__content">
      <div class="about__content__section">
        <div class="about__content__section--text">
          <p>
            I am a software engineer with a background in audiovisual & visual
            communication.
          </p>

          <p class="hero__text--paragraph">
            I'm passionate about building for the web and deeply care about
            crafting beautiful, accessible, and inclusive experiences.
          </p>

          <p>
            I love the intersection between design and engineering. My interests
            also include technical writing, open source, illustration, films &
            photography, knowledge sharing, and everything in between. While a
            big part of my life happens on the screen, I am also an offline
            crafter and a keen reader.
          </p>
          <p>
            Find out more about <a href="/projects"
              >what I've been working on lately</a
            >, and feel free to connect. I’m always happy to share learnings and
            experiences, and open to collaborating on projects that resonate
            with my interests.
          </p>
        </div>
      </div>
    </div>
  </main>

  <style lang="scss">
    @use "../styles/mixins";

    .about {
      &__content {
        &__section {
          display: flex;

          @include mixins.phone {
            flex-direction: column;
            justify-content: center;
            align-items: center;
          }
          &--image {
            z-index: -1;
            // width: 300px;
            // height: 300px;
            padding: 3em 4em 3em 0;
          }
          &--text {
            font-size: 1.1em;
            margin-left: 0;
            @include mixins.tablet {
              margin-right: 0;
            }
          }
        }
      }
    }
  </style>
</Layout>
